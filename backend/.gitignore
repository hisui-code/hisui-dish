# PHP / Laravel
/.phpunit.cache
.phpunit.result.cache
/vendor

# Node (if used)
/node_modules

# Build artifacts
/public/build
/public/hot
/public/storage

# Environment files
.env
.env.*

# Storage (do NOT commit runtime artifacts)
/storage/*
!/storage/.gitignore
!/storage/app/.gitignore
!/storage/app/public/.gitignore
!/storage/framework/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
/storage/*.key

# Laravel cache / generated files
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Tooling / editor
auth.json
npm-debug.log
yarn-error.log
Homestead.json
Homestead.yaml
/.fleet
/.idea
