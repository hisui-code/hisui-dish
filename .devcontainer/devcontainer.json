{
  "name": "HisuiDish Dev",
  "dockerComposeFile": ["infra/docker/docker-compose.dev.yml"],
  "service": "api",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "misogi.ruby-rubocop",
        "EditorConfig.EditorConfig",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "humao.rest-client",
        "mikestead.dotenv",
        "redhat.vscode-yaml",
        "hbenl.vscode-test-explorer",
        "connorshea.vscode-ruby-test-adapter"
      ],
      "settings": {
        "rubyLsp.rubyVersionManager": {},
        "rubyLsp.useBundler": true,
        "rubyLsp.formatter": "rubocop",
        "rubyLsp.rubocop.useBundler": true,
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "bundle install || true"
}
