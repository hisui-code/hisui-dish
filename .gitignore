# ==============================
# グローバル（OS / エディタ）
# ==============================
.DS_Store
Thumbs.db

# エディタ設定（プロジェクト共有しない方針なら無視）
.idea/
.vscode/

# 一時ファイル
*.swp
*.swo

# ==============================
# 環境変数
# ==============================
# 例: backend/.env / frontend/.env / .env.local など
# どの階層でも .env 系はコミットしない
**/.env
**/.env.*

# example はコミットOK
!**/.env.example

# ==============================
# ログ / キャッシュ（共通）
# ==============================
*.log
coverage/
*.cache

# npm/yarn/pnpm のデバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================
# Frontend（Vite + React）
# ==============================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.eslintcache
frontend/.turbo/

# Next.js を入れる可能性がある場合の保険
frontend/.next/


# ==============================
# Backend（Laravel）
# ==============================
# 依存（Composer / Node）
backend/vendor/
backend/node_modules/

# Laravel の実行時生成物（.gitignore 自体は残す）
backend/storage/logs/*
!backend/storage/logs/.gitignore

backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore

backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore

backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore

backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore

backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore

# bootstrap/cache は生成される PHP を無視（.gitignore は残す）
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# PHPUnit のキャッシュ
backend/.phpunit.result.cache
backend/.phpunit.cache/

# storage の公開シンボリックリンク
backend/public/storage

# ==============================
# DB / ダンプ類
# ==============================
*.sqlite
*.sqlite3
*.sql
*.dump